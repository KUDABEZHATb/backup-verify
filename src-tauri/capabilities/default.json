{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:tray:default",
    "opener:default",
    "notification:default",
    "dialog:default",
    "autostart:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://api.github.com/repos/KUDABEZHATb/backup-verify/releases/latest" }]
    }
  ]
}
