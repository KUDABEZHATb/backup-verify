{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Копия верна",
  "mainBinaryName": "kopiya-verna",
  "identifier": "ru.kopiya-verna.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Копия верна",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "ru-RU"
      },
      "nsis": {
        "languages": [
          "Russian"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2NkIzRUNCN0FEMUQyNTIKUldSUzB0RjZ5ejVydGtBRU9zdG9BUUFQdGpRWVh3Rm9XL0lYVmU1MmVnLzFCVjB0NDhZZFk4Wi8K",
      "endpoints": [
        "https://github.com/KUDABEZHATb/backup-verify/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
